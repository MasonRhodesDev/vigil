# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
#
# Arch package for vigil. Same payload as the Fedora RPM
# (packaging/vigil.spec); all paths are identical across both distros. The
# package depends on greetd. post_install points stock agreety at vigil
# and enables greetd as the display manager when none is set. Custom
# greetd command lines (greetd-game-mode, operator) are left alone.

pkgname=vigil
pkgver=0.2.11
pkgrel=1
pkgdesc="Compositor-less greetd greeter and matching session lockscreen"
arch=('x86_64')
url="https://github.com/MasonRhodesDev/vigil"
license=('GPL-3.0-only')
depends=('greetd' 'seatd' 'libinput' 'libxkbcommon' 'systemd-libs' 'libdrm' 'mesa' 'pam' 'fontconfig')
makedepends=('cargo' 'clang' 'systemd')
checkdepends=('ttf-dejavu')
backup=('etc/pam.d/vigil-lock')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::https://github.com/MasonRhodesDev/vigil/archive/v$pkgver.tar.gz")
sha256sums=('80371bc2a67adba7c300e68b05b029751627802c24632d6816f3e46e67c4e279')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/vigil "$pkgdir/usr/bin/vigil"
  install -Dm755 target/release/vigil-lock "$pkgdir/usr/bin/vigil-lock"

  install -Dm755 dist/setup-greetd "$pkgdir/usr/lib/vigil/setup-greetd"
  install -Dm644 dist/vigil.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/vigil.conf"
  install -Dm644 dist/vigil-lock.pam "$pkgdir/etc/pam.d/vigil-lock"
  install -Dm644 dist/vigil.toml.example "$pkgdir/usr/share/vigil/vigil.toml.example"
  install -Dm644 themes/default/theme.slint "$pkgdir/usr/share/vigil/themes/default.slint"
  install -d "$pkgdir/usr/share/vigil/slint-kit/ui"
  install -m644 themes/kit/ui/*.slint "$pkgdir/usr/share/vigil/slint-kit/ui/"

  # Shared monitor-profile directory (see vigil.install for the group).
  install -dm2775 "$pkgdir/etc/monitor-profiles"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
