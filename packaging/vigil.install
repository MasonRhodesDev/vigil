# Shared monitor-profile group. The greeter reads monitor layouts from
# /etc/monitor-profiles so the login screen arranges displays the way the
# session that follows will, instead of falling back to DRM scan order.
#
# The directory is group-writable so a desktop user can edit layouts without
# root, and no username is baked in anywhere: the admin adds whoever should
# have access with `gpasswd -a <user> monitor-profiles`. hyprstate ships the
# same group and directory, so whichever package installs first wins and the
# other is a no-op.
_monitor_profiles_group() {
    getent group monitor-profiles >/dev/null || groupadd -r monitor-profiles || true
    if [ -d /etc/monitor-profiles ]; then
        chgrp monitor-profiles /etc/monitor-profiles >/dev/null 2>&1 || true
        chmod 2775 /etc/monitor-profiles >/dev/null 2>&1 || true
    fi
}

post_install() {
    _monitor_profiles_group
}

post_upgrade() {
    _monitor_profiles_group
}
