#!/bin/sh
# usage: check-ffi-helper-path LIBRARY BUILD_DIR
#
# The C ABI tests rebuild libvigil_scene_ffi.so in place with a helper from
# the build tree. A library fit to ship names nothing under BUILD_DIR. The
# installed path is not checked: every build of the library holds it, so its
# presence proves nothing.
set -eu
library=$1
build=$2
if grep -aqF "$build" "$library"; then
    echo "$library names a path under $build; package a copy taken before the tests" >&2
    exit 1
fi
