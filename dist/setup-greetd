#!/bin/bash
# Point stock greetd at vigil and enable it as the display manager when
# the machine has none. Never overwrite a custom command (greetd-game-mode
# or operator). Never restart greetd — that tears down a live session.
set -euo pipefail

CFG=/etc/greetd/config.toml

if [ ! -f "$CFG" ]; then
    mkdir -p /etc/greetd
    # The greeter account name is the distro's: Arch greetd creates "greeter",
    # Fedora's creates "greetd". Probe rather than hardcode.
    greeter_user=greeter
    getent passwd greeter >/dev/null || greeter_user=greetd
    cat > "$CFG" <<EOF
[terminal]
vt = 1

[default_session]
command = "/usr/bin/vigil"
user = "$greeter_user"
EOF
elif grep -qE 'command[[:space:]]*=[[:space:]]*".*agreety' "$CFG"; then
    tmp=$(mktemp)
    sed -E 's|^(command[[:space:]]*=[[:space:]]*").*agreety.*(")|\1/usr/bin/vigil\2|' "$CFG" > "$tmp"
    if grep -q '/usr/bin/vigil' "$tmp"; then
        cat "$tmp" > "$CFG"
    fi
    rm -f "$tmp"
fi

if ! systemctl is-enabled display-manager.service >/dev/null 2>&1; then
    systemctl enable greetd.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target >/dev/null 2>&1 || true
fi
