#!/bin/bash
# Point stock greetd at vigil and enable it as the display manager when
# the machine has none. Never overwrite a custom command (greetd-game-mode
# or operator). Never restart greetd — that tears down a live session.
set -euo pipefail

CFG=/etc/greetd/config.toml

if [ ! -f "$CFG" ]; then
    mkdir -p /etc/greetd
    # The greeter account name is the distro's: Arch greetd creates "greeter",
    # Fedora's creates "greetd". Probe rather than hardcode.
    greeter_user=greeter
    getent passwd greeter >/dev/null || greeter_user=greetd
    cat > "$CFG" <<EOF
[terminal]
vt = 1

[default_session]
command = "/usr/bin/vigil"
user = "$greeter_user"
EOF
elif grep -qE 'command[[:space:]]*=[[:space:]]*".*agreety' "$CFG"; then
    tmp=$(mktemp)
    sed -E 's|^(command[[:space:]]*=[[:space:]]*").*agreety.*(")|\1/usr/bin/vigil\2|' "$CFG" > "$tmp"
    if grep -q '/usr/bin/vigil' "$tmp"; then
        cat "$tmp" > "$CFG"
    fi
    rm -f "$tmp"
fi

if ! systemctl is-enabled display-manager.service >/dev/null 2>&1; then
    systemctl enable greetd.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target >/dev/null 2>&1 || true
fi

# The account that owns Vigil's persistent state must be the account greetd
# actually uses for the default greeter.  Distribution defaults differ
# (Arch uses "greeter", Fedora normally uses "greetd"), and an existing
# operator-owned config may deliberately choose either one.  tmpfiles.d
# provides the distro default; reconcile it here without replacing the
# config or touching any state path other than Vigil's packaged default.
state_user=$(awk '
    /^\[default_session\][[:space:]]*$/ { in_default = 1; next }
    /^\[/ { in_default = 0 }
    in_default && /^[[:space:]]*user[[:space:]]*=/ {
        line = $0
        sub(/^[^=]*=[[:space:]]*"/, "", line)
        sub(/"[[:space:]]*$/, "", line)
        print line
        exit
    }
' "$CFG")

if [ -n "$state_user" ] && getent passwd "$state_user" >/dev/null; then
    state_group=$(id -gn "$state_user")
    install -d -m0750 -o "$state_user" -g "$state_group" /var/lib/vigil
    if [ -f /var/lib/vigil/state.toml ]; then
        chown --no-dereference "$state_user:$state_group" /var/lib/vigil/state.toml
        chmod 0600 /var/lib/vigil/state.toml
    fi
fi
