# vigil example configuration — copy to /etc/greetd/vigil.toml.
# Every key is optional; a missing file or broken value falls back to the
# built-in default and can never block login. CLI flags override config.
# The lockscreen loads this file, then MERGES ~/.config/vigil/config.toml
# over it key by key (shared [look] = one visual identity for greeter and
# lock). The user file is a whitelisted overlay, not a replacement: it may
# only restyle the lock.
#
#   overlay-allowed  look.theme/background/fit/clock_format, the
#                    [output."NAME"] tables, profiles.dir, the whole
#                    [lock.transition] ramp shape and easing, and
#                    lock.warning frost_in_ms / frost_alpha / easing /
#                    the [lock.warning.gui] table.
#
#   security floor   lock.grace_secs, lock.warning.duration_ms,
#                    lock.warning.cancel_on_motion_px,
#                    lock.warning.wallpaper_hold_max_ms and
#                    lock.warning.wallpaper_in_ms come from this file
#                    ALONE. A session that could write them could grant
#                    itself an unlock-without-auth window, or a warning
#                    that waits for ever — a one-file disarm of the lock.
#                    lock.warning.wallpaper_in_ms is on this list because
#                    the cancelable warning commits at the END of that
#                    fade: a fade as long as the warning postpones both
#                    the lock and the hold cap that backstops it. Its
#                    [lock.transition] namesake is a ramp shape, not a
#                    deadline, and stays overlay-able.
#
# Greeter-scope keys ([keyboard], [sessions], [users], [power], [greeter],
# [render]) are ignored in the user file: the greeter reads only this one.
# Every ignored user key is named on stderr with its reason, including an
# unrecognised key inside [lock.warning.gui] or [output."NAME"] — those
# tables are taken whole, and an unknown key in one refuses the whole
# table rather than being swallowed. [output."NAME"] merges per connector
# and per field, so a user overriding one output keeps the rest of this
# file's.
#
# `vigil-lock --config PATH` is the exception and stays whole-file — an
# operator and test affordance, already a root-or-owner choice.

[look]
# Runtime theme; falls back to the compiled-in default on any error.
#theme = "/etc/greetd/theme.slint"
# Background image shown on every output (see [output."NAME"] to override).
#background = "/etc/greetd/bg.png"
# One of: stretch | fill | fit | center | tile
#fit = "fill"
# strftime format for the clock.
#clock_format = "%H:%M"

[keyboard]
# XKB keymap for the greeter (RMLVO). Empty fields mean system default.
# A layout that fails to compile logs and falls back — it cannot brick login.
#layout = "us"
#variant = ""
#options = "caps:escape"
#model = ""
#rules = ""

[sessions]
# Extra session directories; empty = /usr/share/wayland-sessions +
# /usr/share/xsessions. A directory whose basename is `xsessions` lists as X11.
#dirs = []
# Session preselected on a machine with no remembered choice (exact Name=
# from the .desktop entry). Your own last successful session still wins.
#default = "Hyprland (uwsm-managed)"
# Preselect the last successful user/session (needs a writable state_file;
# the package ships tmpfiles.d for /var/lib/vigil).
#remember = true
#state_file = "/var/lib/vigil/state.toml"

[render]
# Which renderer draws the greeter: "software" (default) or "gl".
#
# Software is the zero-GPU baseline -- no Mesa, EGL or GBM in the login
# path, which is why it is the default. "gl" renders through FemtoVG on the
# GPU and needs a build with the `gl` feature; it buys fidelity headroom
# (gradients, effects) rather than speed.
#
# Anything unrecognised, a build without the feature, or a GPU that fails to
# initialise falls back to software per output, with a line in the log. A
# rendering preference must never be why someone cannot log in.
#backend = "software"

[profiles]
# Monitor-layout profiles (monitor-profiles format), shared with the
# session manager so the login screen and the desktop agree on scale,
# position, and mode. Defaults to the packaged directory below, which the
# package creates as 2775 root:monitor-profiles -- add yourself to that
# group to edit layouts without root:
#
#     sudo gpasswd -a "$USER" monitor-profiles
#
# An absent or empty directory is not an error: outputs are then laid out
# left-to-right in the order the kernel reports them. Set dir = "" to force
# that off even when profiles are installed.
#dir = "/etc/monitor-profiles"

[users]
# Offer the machine's login-capable users as a list (an "Other…" entry
# always keeps typed names reachable). false = typed names only.
#show_list = true

[power]
# false = the greeter's Restart/Shut Down buttons log instead of acting.
#enabled = true

[greeter]
# Non-empty user = kiosk mode: skip the username stage.
#user = ""
# Non-empty cmd = fixed session command; hides the session picker.
#cmd = []
# A host integration (e.g. an approval daemon) writes a one-line message
# here and the greeter displays it; empty file or unset = no banner.
#banner_file = "/run/vigil/banner"

[lock]
# Seconds after locking during which a key/click unlocks without auth
# (0 = disabled). Never survives suspend.
#grace_secs = 0

[lock.warning]
#duration_ms = 0
#frost_in_ms = 1500
#frost_alpha = 0.35
#wallpaper_in_ms = 1500
#easing = "ease_out"
#cancel_on_motion_px = 8.0
# How long past its scheduled commit the warning may wait for the wallpaper
# before locking anyway with whatever the scene has: a wedged asset pipeline
# must not leave the machine unlocked. Clamped to 30000. NOTE the sense of
# 0 here is the opposite of the other duration keys — it DISABLES the cap
# and waits forever, leaving the screen unlocked until the asset arrives.
#wallpaper_hold_max_ms = 5000

[lock.warning.gui]
#start = "locked"
#offset_ms = 0
#duration_ms = 400
#kind = "fade"

#[[lock.warning.gui.element]]
#selector = "clock"
#start = "painted"
#offset_ms = 0
#duration_ms = 0
#kind = "none"

# Short, non-cancelable frost transition around every manual / before-sleep
# lock (the idle warning above is the long, cancelable form). Lock: tint
# ramps in over frost_in_ms, then the wallpaper over wallpaper_in_ms, then
# the session lock is requested. Unlock: the wallpaper fades out over
# wallpaper_out_ms, then the frost over frost_out_ms. Each ramp is clamped to
# 2000 ms. `--wait` returns that much later. All zero, or `--immediate`, is
# the instant commit. On Hyprland the blur strength follows the frost ramp
# (hyprland-surface-v1 opacity); elsewhere the tint ramps over a fixed blur,
# or with no blur at all. Uses lock.warning.frost_alpha and .gui.
[lock.transition]
#frost_in_ms = 150
#wallpaper_in_ms = 250
#wallpaper_out_ms = 250
#frost_out_ms = 150
#easing = "ease_out"

# Per-output overrides, keyed by connector name (`vigil` logs names at
# startup, e.g. "DP-1"). Overrides beat [look]; CLI flags beat both.
#[output."DP-1"]
#background = "/etc/greetd/side.png"
#fit = "center"
# HiDPI scale for this output. Default is derived from the monitor's EDID
# physical size; set this to override.
#scale = 1.5
