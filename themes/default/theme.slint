// vigil default theme — contract v1 (DESIGN.md §6).
// This component is compiled into the binary as the fallback and doubles as
// the reference implementation of the contract. It must always validate.
//
// Colors and density come from slint-kit `Theme` (LMTT Material You).
// Renderer limits (software baseline): no Path, no drop-shadow, no
// border-radius combined with clip, western-script text only.
//
// Layout: a scaled clock with the login card under it, centered as one
// column; a footer row with the session picker (left), the status banner
// (center) and power (right). Sizes follow the output, so a 4K or portrait
// screen is laid out, not just a 1080p one with more empty space. Rows that
// position things carry fixed heights so geometry does not depend on the
// host's font metrics (tests and the e2e driver click by coordinate).

import { Theme } from "ui/theme.slint";
import { KitButton, KitIconButton } from "ui/controls.slint";
import { KitTitle, KitMuted, KitLabel } from "ui/typography.slint";

export { Theme }

// Outlined control with no fill until hovered: footer and cycler actions
// sit on the wallpaper, so a filled tile would read as a second card.
component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    private property <length> o-shift: Theme.optical-shift(label.font-metrics);
    min-width: label.preferred-width + 2 * Theme.control-pad-x;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-sm;
    border-width: Theme.border-width;
    border-color: Theme.border;
    background: ta.pressed ? Theme.selection-bg : ta.has-hover ? Theme.panel-bg-high : transparent;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        y: root.o-shift;
        width: 100%;
        height: 100%;
        text: root.text;
        color: Theme.fg;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DefaultTheme inherits Window {
    // ---- inputs (set by vigil) ------------------------------------------
    in property <string> output-name;
    // Who this screen belongs to (lock: the session user). Empty = hidden.
    in property <string> user-name;
    // Optional: the first letter of `user-name`, for the avatar.
    in property <string> user-initial;
    // Optional: full name and picture of `user-name` (AccountsService, else
    // GECOS for the name). Empty name / zero-size image = not known.
    in property <string> user-display-name;
    in property <image> user-icon;
    in property <bool> panel-visible: true;
    in property <bool> power-visible: true;
    in property <float> warning-frost: 0;
    in property <float> warning-wallpaper: 0;
    in property <float> warning-clock-progress: 1;
    in property <float> warning-user-selector-progress: 1;
    in property <float> warning-password-progress: 1;
    in property <float> warning-status-progress: 1;
    in property <float> warning-power-progress: 1;
    in property <image> background-source;
    in property <bool> native-background: false;
    in property <string> clock-text;
    in property <string> auth-state: "idle";
    in property <string> prompt-text;
    in property <bool> prompt-is-secret: true;
    in property <string> info-message;
    in property <string> error-message;
    // Optional: bumped by vigil each time it shows an error.
    in property <int> error-serial;
    in property <[string]> sessions;
    in property <int> selected-session;
    in property <[string]> users;
    in property <int> selected-user;
    in property <bool> caps-lock;
    in property <string> status-banner;
    in property <string> color-scheme;
    in property <color> accent-color: Theme.accent;

    // ---- outputs (invoked by the theme) ---------------------------------
    callback submit(string);
    callback cancel();
    callback session-changed(int);
    callback user-changed(int);
    callback power-action(string);

    background: root.native-background ? transparent : Theme.page-bg;
    default-font-size: Theme.font-body;
    forward-focus: input;

    // Local: whether a secret prompt is temporarily revealed.
    property <bool> reveal: false;

    // A new prompt is a new question: never carry typed text across (a
    // password typed at a secret prompt must not surface at a visible one),
    // and never carry the reveal state either.
    changed prompt-text => { input.text = ""; root.reveal = false; }
    changed prompt-is-secret => { input.text = ""; root.reveal = false; }

    // A failed attempt shakes the password group once. A repeat failure can
    // leave every other input unchanged, hence `error-serial`. Errors raised
    // together arrive as one change, so the local count steps once per
    // batch; a finite animation chases it and nothing keeps the frame clock
    // running after.
    property <int> shake-count;
    changed error-serial => { root.shake-count += 1; }
    property <float> shake-phase: root.shake-count;
    animate shake-phase { duration: 300ms; easing: linear; }
    property <float> shake-t: 1 - (root.shake-count - root.shake-phase);
    property <length> shake-dx: root.snap(sin(root.shake-t * 720deg) * 8px * (1 - root.shake-t));

    // ---- geometry -------------------------------------------------------
    // Whole logical pixels only: fractional Y blurs glyphs.
    pure function snap(l: length) -> length { floor(l / 1px) * 1px }

    property <length> short-side: min(root.width, root.height);
    property <bool> portrait: root.height > root.width;
    // Screen-edge margin: the kit's page pad, growing a little on big outputs.
    property <length> edge: root.snap(max(Theme.page-pad, min(48px, root.short-side * 0.03)));
    // The clock carries the screen. It is larger on outputs without the
    // panel, where it is the only thing in the middle.
    property <length> clock-size: root.snap(max(64px, min(200px, root.short-side * (root.panel-visible ? 0.11 : 0.14))));
    property <length> clock-height: root.snap(root.clock-size * 1.2);
    property <length> clock-gap: root.snap(root.clock-size * 0.38);
    property <length> card-width: min(root.width - 2 * root.edge, max(360px, min(440px, root.width * 0.22)));
    property <length> footer-y: root.height - root.edge - Theme.control-height;
    // Room the session picker and power buttons each take in the footer.
    property <length> footer-side: 280px;
    // Footer rows: one in landscape; in portrait power, the session picker
    // and the banner stack.
    property <int> footer-rows: !root.portrait ? 1
        : 1 + (root.has-sessions ? 1 : 0) + (root.status-banner != "" ? 1 : 0);
    property <length> footer-top: root.footer-y - (root.footer-rows - 1) * (Theme.control-height + Theme.space-md);
    // The clock + card column, centered over the space above the footer
    // and lifted slightly toward the optical center.
    property <length> column-height: root.clock-height + (root.panel-visible ? root.clock-gap + card.height : 0);
    property <length> column-y: root.snap(max(root.edge, (root.footer-top - root.height * 0.04 - root.column-height) / 2));

    // Manual entry ("Other…" in the picker): no account is known yet.
    property <bool> manual-user: root.users.length > 1 && root.user-name == "";

    Image {
        visible: !root.native-background;
        source: root.background-source;
        width: 100%;
        height: 100%;
    }

    // A flat scrim keeps the large clock readable over a busy wallpaper
    // (no drop shadows on the software renderer). A native background is
    // always a wallpaper, so the lock gets it too; it is drawn once and only
    // blended again where something above it changes.
    Rectangle {
        visible: root.native-background || root.background-source.width > 0;
        background: Theme.page-bg.with-alpha(0.28);
    }

    clock := Text {
        opacity: root.warning-clock-progress;
        text: root.clock-text;
        color: Theme.fg;
        font-size: root.clock-size;
        letter-spacing: -0.02 * root.clock-size;
        x: 0;
        y: root.column-y;
        width: root.width;
        height: root.clock-height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Login card, only on the panel output. `visible` (not `if`) keeps the
    // TextInput alive so keyboard focus survives panel moves. Its height
    // comes from its content. The card fill fades with the larger of the
    // two warning groups it holds; each group fades on its own.
    card := Rectangle {
        visible: root.panel-visible;
        // Eases the card in when the panel arrives on this output.
        property <float> arrive: root.panel-visible ? 1 : 0;
        animate arrive { duration: 180ms; easing: ease-out; }
        property <float> fill: max(root.warning-user-selector-progress, root.warning-password-progress) * self.arrive;

        width: root.card-width;
        height: card-layout.preferred-height;
        x: root.snap((root.width - self.width) / 2);
        y: root.snap(root.column-y + root.clock-height + root.clock-gap + (1 - self.arrive) * 8px);
        background: Theme.panel-bg.with-alpha(Theme.overlay-alpha * self.fill);
        border-radius: 12px;
        border-width: Theme.border-width;
        border-color: Theme.border.with-alpha(self.fill);

        card-layout := VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;

            // Who: the plain name, or the user picker when there is a list.
            if root.users.length > 1 || root.user-name != "": Rectangle {
                height: Theme.row-height;
                opacity: root.warning-user-selector-progress * card.arrive;

                HorizontalLayout {
                    spacing: Theme.space-md;

                    // Avatar: the account picture, else the initial, or a
                    // hollow "+" when no account is chosen yet.
                    Rectangle {
                        width: Theme.row-height;
                        border-radius: self.width / 2;
                        background: root.manual-user ? transparent : Theme.primary-container;
                        border-width: root.manual-user ? Theme.border-width : 0px;
                        border-color: Theme.border;
                        // vigil hands the picture over already cut to a circle:
                        // the software renderer can't clip to a radius.
                        if !root.manual-user && root.user-icon.width > 0: Image {
                            width: 100%;
                            height: 100%;
                            source: root.user-icon;
                            image-fit: cover;
                        }
                        if root.manual-user || root.user-icon.width == 0: Text {
                            text: root.manual-user ? "+" : root.user-initial;
                            color: root.manual-user ? Theme.fg-muted : Theme.on-primary-container;
                            font-size: Theme.font-title;
                            font-weight: Theme.font-weight-semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    KitTitle {
                        text: root.manual-user ? "Another user"
                            : root.user-display-name != "" ? root.user-display-name
                            : root.users.length > 1 ? root.users[root.selected-user] : root.user-name;
                        color: root.manual-user ? Theme.fg-muted : Theme.fg;
                        font-weight: root.manual-user ? 400 : Theme.font-weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if root.users.length > 1: HorizontalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            padding-right: Theme.space-xs;
                            KitLabel {
                                text: (root.selected-user + 1) + "/" + root.users.length;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            GhostButton {
                                width: Theme.control-height-sm;
                                height: Theme.control-height-sm;
                                text: "‹";
                                clicked => {
                                    root.user-changed(root.selected-user <= 0
                                        ? root.users.length - 1
                                        : root.selected-user - 1);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            GhostButton {
                                width: Theme.control-height-sm;
                                height: Theme.control-height-sm;
                                text: "›";
                                clicked => {
                                    root.user-changed(root.selected-user >= root.users.length - 1
                                        ? 0
                                        : root.selected-user + 1);
                                }
                            }
                        }
                    }
                }
            }

            // The question, the answer, and one status line. The group
            // shakes on a failed attempt; the wrapper keeps its place in the
            // card while it moves.
            Rectangle {
                min-height: group.min-height;
                preferred-height: group.preferred-height;

                group := VerticalLayout {
                    x: root.shake-dx;
                    width: parent.width;
                    height: parent.height;
                    spacing: 6px;

                    KitLabel {
                        opacity: root.warning-password-progress * card.arrive;
                        height: 16px;
                        text: root.prompt-text == "" ? "Password" : root.prompt-text;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        opacity: root.warning-password-progress * card.arrive;
                        height: Theme.row-height;
                        background: Theme.tile-bg;
                        border-radius: Theme.radius-md;
                        border-width: Theme.border-width;
                        border-color: root.auth-state == "error" ? Theme.danger
                            : root.auth-state == "busy" ? Theme.border : root.accent-color;

                        HorizontalLayout {
                            padding-left: Theme.control-pad-x;
                            padding-right: 6px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 6px;

                            input := TextInput {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                color: Theme.fg;
                                font-size: Theme.font-body;
                                single-line: true;
                                input-type: root.prompt-is-secret && !root.reveal
                                    ? InputType.password : InputType.text;
                                // The platform pins cursor_flash_cycle to zero (no
                                // animation clock on an hours-idle prompt), which pins
                                // Slint's cursor bar permanently solid. Next to masked
                                // bullets it reads as furniture; flush against a
                                // revealed password it reads as a stray trailing "|".
                                text-cursor-width: root.prompt-is-secret && root.reveal ? 0px : 1px;
                                accepted => {
                                    root.submit(self.text);
                                    self.text = "";
                                }
                            }

                            // Caps Lock, where the typing happens.
                            if root.caps-lock: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: caps.preferred-width + 12px;
                                    height: caps.preferred-height + 2px;
                                    border-radius: Theme.radius-xs;
                                    border-width: Theme.border-width;
                                    border-color: Theme.warning-fg;
                                    caps := Text {
                                        text: "CAPS";
                                        color: Theme.warning-fg;
                                        font-size: 11px;
                                        font-weight: Theme.font-weight-bold;
                                        letter-spacing: 1px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Reveal toggle, secret prompts only.
                            if root.prompt-is-secret: Rectangle {
                                width: 48px;
                                background: root.reveal ? Theme.accent : transparent;
                                border-radius: Theme.radius-sm;
                                Text {
                                    text: root.reveal ? "hide" : "show";
                                    color: root.reveal ? Theme.on-accent : Theme.fg-muted;
                                    font-size: Theme.font-label;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => { root.reveal = !root.reveal; }
                                }
                            }
                        }

                        // A thin bar sweeps while a check runs. `if` keeps the
                        // frame clock out of every other state: the tick is
                        // only read while this element exists.
                        if root.auth-state == "busy": Rectangle {
                            property <float> t: mod(animation-tick() / 1100ms, 2);
                            property <float> sweep: (1 - cos((self.t < 1 ? self.t : 2 - self.t) * 180deg)) / 2;
                            property <length> track: parent.width - 16px;
                            x: root.snap(8px + self.sweep * self.track * 0.7);
                            y: parent.height - 6px;
                            width: root.snap(self.track * 0.3);
                            height: 2px;
                            border-radius: 1px;
                            background: root.accent-color;
                        }
                    }

                    // Reserved so the card does not jump between states; a long
                    // message wraps and grows it.
                    Text {
                        opacity: root.warning-password-progress * card.arrive;
                        min-height: 20px;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        text: root.auth-state == "busy" ? "Checking…"
                            : root.error-message != "" ? root.error-message
                            : root.info-message != "" ? root.info-message
                            : "Press Enter to continue";
                        color: root.auth-state == "busy" ? Theme.fg-muted
                            : root.error-message != "" ? Theme.danger
                            : root.info-message != "" ? Theme.fg-muted
                            : Theme.fg-muted.with-alpha(0.7);
                    }
                }
            }
        }
    }

    // ---- footer ---------------------------------------------------------

    // In landscape the footer is one row: session picker (left), status
    // banner (center), power (right). In portrait the three stack, centered,
    // power at the bottom.
    property <length> session-y: root.portrait ? root.footer-y - Theme.control-height - Theme.space-md : root.footer-y;
    property <bool> has-sessions: root.panel-visible && root.sessions.length > 1;

    // Session picker, once there is a choice.
    if root.has-sessions: HorizontalLayout {
        opacity: root.warning-user-selector-progress;
        x: root.portrait ? root.snap((root.width - self.preferred-width) / 2) : root.edge;
        y: root.session-y;
        width: self.preferred-width;
        height: Theme.control-height;
        spacing: 6px;

        // Fixed width: the e2e driver clicks "‹" by coordinate.
        KitLabel {
            width: 48px;
            text: "Session";
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            GhostButton {
                width: Theme.control-height-sm;
                height: Theme.control-height-sm;
                text: "‹";
                clicked => {
                    root.session-changed(root.selected-session <= 0
                        ? root.sessions.length - 1
                        : root.selected-session - 1);
                }
            }
        }
        Text {
            width: max(96px, min(200px, self.preferred-width));
            text: root.sessions[root.selected-session];
            color: Theme.fg;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            GhostButton {
                width: Theme.control-height-sm;
                height: Theme.control-height-sm;
                text: "›";
                clicked => {
                    root.session-changed(root.selected-session >= root.sessions.length - 1
                        ? 0
                        : root.selected-session + 1);
                }
            }
        }
    }

    // Power actions.
    HorizontalLayout {
        visible: root.power-visible;
        opacity: root.warning-power-progress;
        x: root.portrait ? root.snap((root.width - self.width) / 2) : root.width - root.edge - self.width;
        y: root.footer-y;
        width: self.preferred-width;
        height: Theme.control-height;
        spacing: Theme.space-sm;

        GhostButton {
            text: "Restart";
            clicked => { root.power-action("reboot"); }
        }
        GhostButton {
            text: "Shut Down";
            clicked => { root.power-action("poweroff"); }
        }
    }

    // Host-integration status banner (reserved contract surface: empty =
    // hidden). In landscape it stays clear of the two footer sides.
    if root.status-banner != "": Rectangle {
        property <length> room: root.width - 2 * root.edge
            - (root.portrait ? 0px : 2 * (root.footer-side + Theme.space-md));
        opacity: root.warning-status-progress;
        height: Theme.control-height;
        width: min(banner.preferred-width + 2 * Theme.space-lg + 16px, self.room);
        x: root.snap((root.width - self.width) / 2);
        y: !root.portrait ? root.footer-y
            : (root.has-sessions ? root.session-y : root.footer-y) - Theme.control-height - Theme.space-md;
        background: Theme.panel-bg.with-alpha(Theme.overlay-alpha);
        border-radius: Theme.control-height / 2;
        border-width: Theme.border-width;
        border-color: Theme.border;

        Rectangle {
            x: Theme.space-lg;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.warning-fg;
        }
        banner := Text {
            text: root.status-banner;
            color: Theme.fg;
            font-size: Theme.font-body;
            x: Theme.space-lg + 16px;
            width: parent.width - 2 * Theme.space-lg - 16px;
            height: 100%;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
