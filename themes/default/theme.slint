// vigil default theme — contract v1 (DESIGN.md §6).
// This component is compiled into the binary as the fallback and doubles as
// the reference implementation of the contract. It must always validate.
//
// Renderer limits (software baseline): no Path, no drop-shadow, no
// border-radius combined with clip, western-script text only.

export component DefaultTheme inherits Window {
    // ---- inputs (set by vigil) ------------------------------------------
    in property <string> output-name;
    // Who this screen belongs to (lock: the session user). Empty = hidden.
    in property <string> user-name;
    in property <bool> panel-visible: true;
    in property <image> background-source;
    in property <string> clock-text;
    in property <string> auth-state: "idle";
    in property <string> prompt-text;
    in property <bool> prompt-is-secret: true;
    in property <string> info-message;
    in property <string> error-message;
    in property <[string]> sessions;
    in property <int> selected-session;
    in property <[string]> users;
    in property <int> selected-user;
    in property <bool> caps-lock;
    in property <string> status-banner;
    in property <string> color-scheme;
    in property <color> accent-color: root.color-scheme == "light" ? #4a6fa5 : #33455a;

    // ---- outputs (invoked by the theme) ---------------------------------
    callback submit(string);
    callback cancel();
    callback session-changed(int);
    callback user-changed(int);
    callback power-action(string);

    background: root.page-bg;
    default-font-size: 15px;
    forward-focus: input;

    // Local: whether a secret prompt is temporarily revealed.
    property <bool> reveal: false;
    // Surfaces, foregrounds and borders follow the desktop's color-scheme
    // (issue #15/#16); error and caps-lock stay semantic constants.
    property <color> page-bg: root.color-scheme == "light" ? #f2f4f7 : #0f151c;
    property <color> card-bg: root.color-scheme == "light" ? #ffffffe6 : #18212ce6;
    property <color> card-border: root.color-scheme == "light" ? #c9d2de : #2b3a4c;
    property <color> well-bg: root.color-scheme == "light" ? #e9edf3 : #0d141d;
    property <color> fg-strong: root.color-scheme == "light" ? #10161d : #e8edf3;
    property <color> fg-muted: root.color-scheme == "light" ? #4a5666 : #9fb3c8;
    property <color> fg-input: root.color-scheme == "light" ? #0d141a : #eef2f7;
    property <color> fg-clock: root.color-scheme == "light" ? #1b232c : #d8e0ea;

    // A new prompt is a new question: never carry typed text across (a
    // password typed at a secret prompt must not surface at a visible one),
    // and never carry the reveal state either.
    changed prompt-text => { input.text = ""; root.reveal = false; }
    changed prompt-is-secret => { input.text = ""; root.reveal = false; }

    Image {
        source: root.background-source;
        width: 100%;
        height: 100%;
    }

    // Clock, top-right.
    Text {
        text: root.clock-text;
        color: root.fg-clock;
        font-size: 30px;
        x: parent.width - self.width - 36px;
        y: 28px;
    }

    // Login card, centered, only on the panel output. `visible` (not `if`)
    // keeps the TextInput alive so keyboard focus survives panel moves.
    Rectangle {
        visible: root.panel-visible;
        width: 400px;
        height: 300px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.card-bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.card-border;

        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            alignment: start;

            // With a list, the top row becomes a user cycler; without one
            // it stays the plain name (or nothing, when unknown).
            if root.users.length > 1: HorizontalLayout {
                spacing: 8px;
                height: 30px;

                Rectangle {
                    width: 30px;
                    background: root.well-bg;
                    border-radius: 6px;
                    Text { text: "‹"; color: root.fg-muted; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.user-changed(root.selected-user <= 0
                                ? root.users.length - 1
                                : root.selected-user - 1);
                        }
                    }
                }
                Text {
                    text: root.users[root.selected-user];
                    color: root.fg-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 30px;
                    background: root.well-bg;
                    border-radius: 6px;
                    Text { text: "›"; color: root.fg-muted; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.user-changed(root.selected-user >= root.users.length - 1
                                ? 0
                                : root.selected-user + 1);
                        }
                    }
                }
            }

            if root.users.length <= 1 && root.user-name != "": Text {
                text: root.user-name;
                color: root.fg-muted;
                font-size: 14px;
            }

            Text {
                text: root.prompt-text == "" ? "Password" : root.prompt-text;
                color: root.fg-strong;
                font-size: 17px;
            }

            Rectangle {
                height: 44px;
                background: root.well-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.auth-state == "error" ? #b3475a : root.accent-color;

                input := TextInput {
                    x: 14px;
                    width: parent.width - 28px - (root.prompt-is-secret ? 56px : 0px);
                    vertical-alignment: center;
                    color: root.fg-input;
                    font-size: 16px;
                    single-line: true;
                    input-type: root.prompt-is-secret && !root.reveal
                        ? InputType.password : InputType.text;
                    accepted => {
                        root.submit(self.text);
                        self.text = "";
                    }
                }

                // Reveal toggle, secret prompts only.
                if root.prompt-is-secret: Rectangle {
                    x: parent.width - 56px;
                    width: 48px;
                    height: parent.height - 12px;
                    y: 6px;
                    background: root.reveal ? root.accent-color : transparent;
                    border-radius: 6px;
                    Text {
                        text: root.reveal ? "hide" : "show";
                        color: root.fg-muted;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.reveal = !root.reveal; }
                    }
                }
            }

            // Session picker: a cycler, shown once there is a choice.
            if root.sessions.length > 1: HorizontalLayout {
                spacing: 8px;
                height: 30px;

                Rectangle {
                    width: 30px;
                    background: root.well-bg;
                    border-radius: 6px;
                    Text { text: "‹"; color: root.fg-muted; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.session-changed(root.selected-session <= 0
                                ? root.sessions.length - 1
                                : root.selected-session - 1);
                        }
                    }
                }
                Text {
                    text: root.sessions[root.selected-session];
                    color: root.fg-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 30px;
                    background: root.well-bg;
                    border-radius: 6px;
                    Text { text: "›"; color: root.fg-muted; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.session-changed(root.selected-session >= root.sessions.length - 1
                                ? 0
                                : root.selected-session + 1);
                        }
                    }
                }
            }

            if root.caps-lock: Text {
                text: "Caps Lock is on";
                color: #e0b64f;
            }

            if root.error-message != "": Text {
                text: root.error-message;
                color: #e3697f;
                wrap: word-wrap;
            }

            if root.error-message == "" && root.info-message != "": Text {
                text: root.info-message;
                color: root.fg-muted;
                wrap: word-wrap;
            }

            if root.auth-state == "busy": Text {
                text: "Checking…";
                color: root.fg-muted;
            }
        }
    }

    // Power actions, bottom-left.
    HorizontalLayout {
        x: 36px;
        y: parent.height - 76px;
        height: 40px;
        spacing: 14px;

        Rectangle {
            width: restart-label.width + 32px;
            background: root.card-bg;
            border-radius: 8px;
            restart-label := Text {
                text: "Restart";
                color: root.fg-muted;
                x: 16px;
                vertical-alignment: center;
                height: 100%;
            }
            TouchArea {
                clicked => { root.power-action("reboot"); }
            }
        }
        Rectangle {
            width: poweroff-label.width + 32px;
            background: root.card-bg;
            border-radius: 8px;
            poweroff-label := Text {
                text: "Shut Down";
                color: root.fg-muted;
                x: 16px;
                vertical-alignment: center;
                height: 100%;
            }
            TouchArea {
                clicked => { root.power-action("poweroff"); }
            }
        }
    }

    // Host-integration status banner, bottom-center (reserved contract
    // surface: empty = hidden).
    if root.status-banner != "": Rectangle {
        height: 40px;
        width: banner.width + 48px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 76px;
        background: root.card-bg;
        border-radius: 8px;

        banner := Text {
            text: root.status-banner;
            color: root.fg-clock;
            x: 24px;
            vertical-alignment: center;
            height: 100%;
        }
    }
}
