// vigil default theme — contract v1 (DESIGN.md §6).
// This component is compiled into the binary as the fallback and doubles as
// the reference implementation of the contract. It must always validate.
//
// Renderer limits (software baseline): no Path, no drop-shadow, no
// border-radius combined with clip, western-script text only.

export component DefaultTheme inherits Window {
    // ---- inputs (set by vigil) ------------------------------------------
    in property <string> output-name;
    // Who this screen belongs to (lock: the session user). Empty = hidden.
    in property <string> user-name;
    in property <bool> panel-visible: true;
    in property <image> background-source;
    in property <string> clock-text;
    in property <string> auth-state: "idle";
    in property <string> prompt-text;
    in property <bool> prompt-is-secret: true;
    in property <string> info-message;
    in property <string> error-message;
    in property <[string]> sessions;
    in property <int> selected-session;
    in property <bool> caps-lock;
    in property <string> status-banner;

    // ---- outputs (invoked by the theme) ---------------------------------
    callback submit(string);
    callback cancel();
    callback session-changed(int);
    callback power-action(string);

    background: #0f151c;
    default-font-size: 15px;
    forward-focus: input;

    // Local: whether a secret prompt is temporarily revealed.
    property <bool> reveal: false;

    // A new prompt is a new question: never carry typed text across (a
    // password typed at a secret prompt must not surface at a visible one),
    // and never carry the reveal state either.
    changed prompt-text => { input.text = ""; root.reveal = false; }
    changed prompt-is-secret => { input.text = ""; root.reveal = false; }

    Image {
        source: root.background-source;
        width: 100%;
        height: 100%;
    }

    // Clock, top-right.
    Text {
        text: root.clock-text;
        color: #d8e0ea;
        font-size: 30px;
        x: parent.width - self.width - 36px;
        y: 28px;
    }

    // Login card, centered, only on the panel output. `visible` (not `if`)
    // keeps the TextInput alive so keyboard focus survives panel moves.
    Rectangle {
        visible: root.panel-visible;
        width: 400px;
        height: 300px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #18212ce6;
        border-radius: 14px;
        border-width: 1px;
        border-color: #2b3a4c;

        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            alignment: start;

            if root.user-name != "": Text {
                text: root.user-name;
                color: #9fb3c8;
                font-size: 14px;
            }

            Text {
                text: root.prompt-text == "" ? "Password" : root.prompt-text;
                color: #e8edf3;
                font-size: 17px;
            }

            Rectangle {
                height: 44px;
                background: #0d141d;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.auth-state == "error" ? #b3475a : #33455a;

                input := TextInput {
                    x: 14px;
                    width: parent.width - 28px - (root.prompt-is-secret ? 56px : 0px);
                    vertical-alignment: center;
                    color: #eef2f7;
                    font-size: 16px;
                    single-line: true;
                    input-type: root.prompt-is-secret && !root.reveal
                        ? InputType.password : InputType.text;
                    accepted => {
                        root.submit(self.text);
                        self.text = "";
                    }
                }

                // Reveal toggle, secret prompts only.
                if root.prompt-is-secret: Rectangle {
                    x: parent.width - 56px;
                    width: 48px;
                    height: parent.height - 12px;
                    y: 6px;
                    background: root.reveal ? #33455a : transparent;
                    border-radius: 6px;
                    Text {
                        text: root.reveal ? "hide" : "show";
                        color: #9fb3c8;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.reveal = !root.reveal; }
                    }
                }
            }

            // Session picker: a cycler, shown once there is a choice.
            if root.sessions.length > 1: HorizontalLayout {
                spacing: 8px;
                height: 30px;

                Rectangle {
                    width: 30px;
                    background: #0d141d;
                    border-radius: 6px;
                    Text { text: "‹"; color: #9fb3c8; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.session-changed(root.selected-session <= 0
                                ? root.sessions.length - 1
                                : root.selected-session - 1);
                        }
                    }
                }
                Text {
                    text: root.sessions[root.selected-session];
                    color: #9fb3c8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 30px;
                    background: #0d141d;
                    border-radius: 6px;
                    Text { text: "›"; color: #9fb3c8; font-size: 18px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        clicked => {
                            root.session-changed(root.selected-session >= root.sessions.length - 1
                                ? 0
                                : root.selected-session + 1);
                        }
                    }
                }
            }

            if root.caps-lock: Text {
                text: "Caps Lock is on";
                color: #e0b64f;
            }

            if root.error-message != "": Text {
                text: root.error-message;
                color: #e3697f;
                wrap: word-wrap;
            }

            if root.error-message == "" && root.info-message != "": Text {
                text: root.info-message;
                color: #9fb3c8;
                wrap: word-wrap;
            }

            if root.auth-state == "busy": Text {
                text: "Checking…";
                color: #9fb3c8;
            }
        }
    }

    // Power actions, bottom-left.
    HorizontalLayout {
        x: 36px;
        y: parent.height - 76px;
        height: 40px;
        spacing: 14px;

        Rectangle {
            width: restart-label.width + 32px;
            background: #18212ce6;
            border-radius: 8px;
            restart-label := Text {
                text: "Restart";
                color: #9fb3c8;
                x: 16px;
                vertical-alignment: center;
                height: 100%;
            }
            TouchArea {
                clicked => { root.power-action("reboot"); }
            }
        }
        Rectangle {
            width: poweroff-label.width + 32px;
            background: #18212ce6;
            border-radius: 8px;
            poweroff-label := Text {
                text: "Shut Down";
                color: #9fb3c8;
                x: 16px;
                vertical-alignment: center;
                height: 100%;
            }
            TouchArea {
                clicked => { root.power-action("poweroff"); }
            }
        }
    }

    // Host-integration status banner, bottom-center (reserved contract
    // surface: empty = hidden).
    if root.status-banner != "": Rectangle {
        height: 40px;
        width: banner.width + 48px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 76px;
        background: #18212ce6;
        border-radius: 8px;

        banner := Text {
            text: root.status-banner;
            color: #d8e0ea;
            x: 24px;
            vertical-alignment: center;
            height: 100%;
        }
    }
}
