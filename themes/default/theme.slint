// vigil default theme — contract v1 (DESIGN.md §6).
// This component is compiled into the binary as the fallback and doubles as
// the reference implementation of the contract. It must always validate.
//
// Renderer limits (software baseline): no Path, no drop-shadow, no
// border-radius combined with clip, western-script text only.

export component DefaultTheme inherits Window {
    // ---- inputs (set by vigil) ------------------------------------------
    in property <string> output-name;
    in property <bool> panel-visible: true;
    in property <image> background-source;
    in property <string> clock-text;
    in property <string> auth-state: "idle";
    in property <string> prompt-text;
    in property <bool> prompt-is-secret: true;
    in property <string> info-message;
    in property <string> error-message;
    in property <[string]> sessions;
    in property <int> selected-session;
    in property <bool> caps-lock;
    in property <string> status-banner;

    // ---- outputs (invoked by the theme) ---------------------------------
    callback submit(string);
    callback cancel();
    callback session-changed(int);
    callback power-action(string);

    background: #0f151c;
    default-font-size: 15px;
    forward-focus: input;

    Image {
        source: root.background-source;
        width: 100%;
        height: 100%;
    }

    // Clock, top-right.
    Text {
        text: root.clock-text;
        color: #d8e0ea;
        font-size: 30px;
        x: parent.width - self.width - 36px;
        y: 28px;
    }

    // Login card, centered, only on the panel output. `visible` (not `if`)
    // keeps the TextInput alive so keyboard focus survives panel moves.
    Rectangle {
        visible: root.panel-visible;
        width: 400px;
        height: 240px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #18212ce6;
        border-radius: 14px;
        border-width: 1px;
        border-color: #2b3a4c;

        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            alignment: start;

            Text {
                text: root.prompt-text == "" ? "Password" : root.prompt-text;
                color: #e8edf3;
                font-size: 17px;
            }

            Rectangle {
                height: 44px;
                background: #0d141d;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.auth-state == "error" ? #b3475a : #33455a;

                input := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    vertical-alignment: center;
                    color: #eef2f7;
                    font-size: 16px;
                    single-line: true;
                    input-type: root.prompt-is-secret ? InputType.password : InputType.text;
                    accepted => {
                        root.submit(self.text);
                        self.text = "";
                    }
                }
            }

            if root.caps-lock: Text {
                text: "Caps Lock is on";
                color: #e0b64f;
            }

            if root.error-message != "": Text {
                text: root.error-message;
                color: #e3697f;
                wrap: word-wrap;
            }

            if root.error-message == "" && root.info-message != "": Text {
                text: root.info-message;
                color: #9fb3c8;
                wrap: word-wrap;
            }

            if root.auth-state == "busy": Text {
                text: "Checking…";
                color: #9fb3c8;
            }
        }
    }

    // Host-integration status banner, bottom-center (reserved contract
    // surface: empty = hidden).
    if root.status-banner != "": Rectangle {
        height: 40px;
        width: banner.width + 48px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 76px;
        background: #18212ce6;
        border-radius: 8px;

        banner := Text {
            text: root.status-banner;
            color: #d8e0ea;
            x: 24px;
            vertical-alignment: center;
            height: 100%;
        }
    }
}
