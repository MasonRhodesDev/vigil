// Typography primitives — Tailwind-ish text recipes on Theme tokens.
//
// Every text here binds `min-height: self.preferred-height`. Slint 1.17
// measures a conditional (`if`) or repeated (`for`) layout child at its
// preferred width, so a wrapped text inside one would report a single line's
// height and the items after it would be drawn over it. `preferred-height`
// is computed from the text's real width, so the minimum keeps the cell
// honest wherever the text sits; for unwrapped text it equals the implicit
// height and changes nothing. `min-height` rather than `height` so a text in
// a row can still stretch and use `vertical-alignment`.
import { Theme } from "theme.slint";

export component KitLabel inherits Text {
    color: Theme.fg-muted;
    font-size: Theme.font-label;
    vertical-stretch: 0;
    min-height: self.preferred-height;
    horizontal-alignment: left;
    overflow: elide;
}

export component KitMuted inherits Text {
    in property <bool> wrap-text: false;
    color: Theme.fg-muted;
    font-size: Theme.font-body;
    vertical-stretch: 0;
    min-height: self.preferred-height;
    horizontal-alignment: left;
    overflow: elide;
    wrap: root.wrap-text ? word-wrap : no-wrap;
}

export component KitTitle inherits Text {
    color: Theme.fg;
    font-size: Theme.font-title;
    font-weight: Theme.font-weight-semibold;
    vertical-stretch: 0;
    min-height: self.preferred-height;
    horizontal-alignment: left;
    overflow: elide;
}

export component KitDisplay inherits Text {
    color: Theme.fg;
    font-size: Theme.font-display;
    font-weight: Theme.font-weight-bold;
    vertical-stretch: 0;
    min-height: self.preferred-height;
    horizontal-alignment: left;
    overflow: elide;
}

export component KitWarning inherits Text {
    color: Theme.warning-fg;
    font-size: Theme.font-body;
    vertical-stretch: 0;
    min-height: self.preferred-height;
    horizontal-alignment: left;
    wrap: word-wrap;
}
